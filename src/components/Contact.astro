---
import { site } from '../data/site.js';
import '../styles/contact.css';
---
<section class="close" id="consult">
  <div class="sc-stack" data-sc-in data-sc-stagger="70">
    <h2 class="close__headline">Let's build something extraordinary.</h2>
    <p class="close__body">Your next home should be the most remarkable thing on the street. We would like to hear what that means to you.</p>
    <a href={`mailto:${site.bookingEmail}`} class="close__btn">Book a Consultation</a>
  </div>
</section>
